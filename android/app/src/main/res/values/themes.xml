<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One high-contrast dark theme in every system mode, so contrast never depends on the phone setting. -->
    <style name="Theme.OpenEyes" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
    </style>

    <style name="OpenEyes.Status" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <style name="OpenEyes.Button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_secondary</item>
        <item name="backgroundTint">@color/secondary</item>
    </style>

    <style name="OpenEyes.Button.Primary">
        <item name="android:minHeight">96dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="OpenEyes.Button.Danger">
        <item name="android:textColor">@color/on_danger</item>
        <item name="backgroundTint">@color/danger</item>
    </style>
</resources>
