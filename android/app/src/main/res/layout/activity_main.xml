<?xml version="1.0" encoding="utf-8"?>
<!-- One screen is visible at a time; MainActivity switches them so the glasses connection is shared. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include android:id="@+id/screen_home" layout="@layout/screen_home" />
    <include android:id="@+id/screen_explore" layout="@layout/screen_explore" android:visibility="gone" />
    <include android:id="@+id/screen_find" layout="@layout/screen_find" android:visibility="gone" />
    <include android:id="@+id/screen_read" layout="@layout/screen_read" android:visibility="gone" />
    <include android:id="@+id/screen_ask" layout="@layout/screen_ask" android:visibility="gone" />
</FrameLayout>
