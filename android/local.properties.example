# Copy to local.properties (never commit it). Android Studio also writes sdk.dir here.
# sdk.dir=/Users/you/Library/Android/sdk

# OpenEyes server function. The public key is the same public (anon) key the website uses; it is not a secret,
# and the Meta API key never leaves the server.
openeyes.functionUrl=https://YOUR-PROJECT.supabase.co/functions/v1/openeyes-ai
openeyes.publicKey=YOUR_PUBLIC_ANON_KEY

# Meta Wearables Developer Center credentials. Keep 0 while Developer Mode is on in the Meta AI app.
mwdat.applicationId=0
mwdat.clientToken=0
